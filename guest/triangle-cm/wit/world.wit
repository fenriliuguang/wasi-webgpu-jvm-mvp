/// Experimental Component Model compute + minimal surface/render subset.
///
/// Method names lean toward wasi:webgpu@0.3.0-rc.2 paths, but this is
/// NOT a compliant wasi:webgpu world:
/// - package remains experimental
/// - handles are WIT resources (not the full wasi:webgpu resource surface)
/// - async WIT methods are sync (matching L2)
/// - surface/render helpers are triangle-demo shaped (Android native window)
///
/// 0.2.0: buffer-descriptor + buffer-usage/map-mode flag aliases (u32),
/// aligned with pinned wasi:webgpu record/flag shape for create-buffer / map-async.
/// 0.3.0: surface + render-pipeline / render-pass (Android native window; no Guest canvas).
/// 0.4.0: vertex-buffer-layout records + set-vertex-buffer +
/// create-render-pipeline-triangle-buffers (slice A / E vertex-buffer path).
/// 0.5.0: standard bind-group-layout / bind-group / compute-pipeline descriptors +
/// queue.submit(list); keep *storage3 / *3 / submit1 / create-compute-pipeline-bgl deprecated
/// (compliant-world slice C). compute-pipeline.layout is still bind-group-layout (L2);
/// wasi pipeline-layout lands in slice D.
/// 0.6.0: texture / sampler / pipeline-layout + BGL/BG sampler·texture entries;
/// compute-pipeline.layout is pipeline-layout (compliant-world slice D).

package experimental:webgpu-cm@0.6.0;

interface host {
  /// WebGPU GPUBufferUsage bitfield (same bit values as wasi:webgpu / L2 GpuBufferUsage).
  type buffer-usage-flags = u32;
  /// WebGPU GPUMapMode bitfield (same bit values as L2 GpuMapMode).
  type map-mode-flags = u32;
  /// WebGPU GPUShaderStage bitfield (VERTEX=1, FRAGMENT=2, COMPUTE=4).
  type shader-stage-flags = u32;
  /// 0=uniform, 1=storage, 2=read-only-storage (L2 BufferBindingType ordinal).
  type buffer-binding-type = u32;
  /// 0=filtering, 1=non-filtering, 2=comparison.
  type sampler-binding-type = u32;
  /// 0=float, 1=unfilterable-float, 2=depth, 3=sint, 4=uint.
  type texture-sample-type = u32;
  /// 0=d1, 1=d2, 2=d2-array, 3=cube, 4=cube-array, 5=d3.
  type texture-view-dimension = u32;
  /// Dawn / WebGPU texture format enum value (u32).
  type texture-format = u32;
  /// WebGPU GPUTextureUsage bitfield.
  type texture-usage-flags = u32;
  /// Dawn TextureDimension pass-through (u32).
  type texture-dimension = u32;
  /// Dawn / WebGPU GPUVertexFormat enum value (u32); e.g. float32x2.
  type vertex-format = u32;
  /// Dawn / WebGPU GPUVertexStepMode enum value (u32); vertex / instance.
  type vertex-step-mode = u32;

  record buffer-descriptor {
    size: u64,
    usage: buffer-usage-flags,
    mapped-at-creation: bool,
    label: option<string>,
  }

  record extent3-d {
    width: u32,
    height: u32,
    depth-or-array-layers: u32,
  }

  record texture-descriptor {
    size: extent3-d,
    format: texture-format,
    usage: texture-usage-flags,
    mip-level-count: u32,
    sample-count: u32,
    dimension: texture-dimension,
    label: option<string>,
  }

  record sampler-descriptor {
    label: option<string>,
  }

  record pipeline-layout-descriptor {
    bind-group-layouts: list<borrow<bind-group-layout>>,
    label: option<string>,
  }

  record vertex-attribute {
    format: vertex-format,
    offset: u64,
    shader-location: u32,
  }

  record vertex-buffer-layout {
    array-stride: u64,
    step-mode: vertex-step-mode,
    attributes: list<vertex-attribute>,
  }

  record buffer-binding-layout {
    %type: buffer-binding-type,
    has-dynamic-offset: bool,
    min-binding-size: u64,
  }

  record sampler-binding-layout {
    %type: sampler-binding-type,
  }

  record texture-binding-layout {
    sample-type: texture-sample-type,
    view-dimension: texture-view-dimension,
    multisampled: bool,
  }

  record bind-group-layout-entry {
    binding: u32,
    visibility: shader-stage-flags,
    buffer: option<buffer-binding-layout>,
    sampler: option<sampler-binding-layout>,
    texture: option<texture-binding-layout>,
  }

  record bind-group-layout-descriptor {
    entries: list<bind-group-layout-entry>,
    label: option<string>,
  }

  record buffer-binding {
    buffer: borrow<buffer>,
    offset: u64,
    size: option<u64>,
  }

  /// Buffer / sampler / texture-view (no storage-texture yet).
  record bind-group-entry {
    binding: u32,
    buffer: option<buffer-binding>,
    sampler: option<borrow<sampler>>,
    texture-view: option<borrow<texture-view>>,
  }

  record bind-group-descriptor {
    layout: borrow<bind-group-layout>,
    entries: list<bind-group-entry>,
    label: option<string>,
  }

  record programmable-stage {
    module: borrow<shader-module>,
    entry-point: option<string>,
  }

  record compute-pipeline-descriptor {
    compute: programmable-stage,
    layout: borrow<pipeline-layout>,
    label: option<string>,
  }

  resource adapter {
    request-device: func() -> device;
  }

  resource device {
    get-queue: func() -> queue;
    create-buffer: func(descriptor: buffer-descriptor) -> buffer;
    create-shader-module: func(code: string) -> shader-module;
    create-bind-group-layout: func(descriptor: bind-group-layout-descriptor) -> bind-group-layout;
    create-bind-group: func(descriptor: bind-group-descriptor) -> bind-group;
    create-texture: func(descriptor: texture-descriptor) -> texture;
    create-sampler: func(descriptor: option<sampler-descriptor>) -> sampler;
    create-pipeline-layout: func(descriptor: pipeline-layout-descriptor) -> pipeline-layout;
    create-compute-pipeline: func(descriptor: compute-pipeline-descriptor) -> compute-pipeline;
    /// Deprecated (slice C): fixed 3× storage layout helper.
    create-bind-group-layout-storage3: func() -> bind-group-layout;
    /// Deprecated (slice C): three-buffer bind-group helper.
    create-bind-group3: func(
      layout: borrow<bind-group-layout>,
      b0: borrow<buffer>,
      b1: borrow<buffer>,
      b2: borrow<buffer>,
    ) -> bind-group;
    /// Deprecated (slice C/D): BGL helper that builds a 1× pipeline-layout internally.
    create-compute-pipeline-bgl: func(
      layout: borrow<bind-group-layout>,
      shader: borrow<shader-module>,
      entry-point: string,
    ) -> compute-pipeline;
    /// Empty vertex-buffer layout TriangleList; shader uses @builtin(vertex_index).
    /// Prefer create-render-pipeline-triangle-buffers for @location attributes.
    create-render-pipeline-triangle: func(
      shader: borrow<shader-module>,
      format: texture-format,
    ) -> render-pipeline;
    /// TriangleList with explicit vertex-buffer layouts (slice A / E).
    create-render-pipeline-triangle-buffers: func(
      shader: borrow<shader-module>,
      format: texture-format,
      buffers: list<vertex-buffer-layout>,
    ) -> render-pipeline;
    create-command-encoder: func() -> command-encoder;
  }

  resource queue {
    write-buffer: func(buffer: borrow<buffer>, offset: u64, data: list<u8>);
    /// Standard-shaped submit (list); prefer over submit1.
    submit: func(command-buffers: list<borrow<command-buffer>>);
    /// Deprecated (slice C): single command-buffer submit.
    submit1: func(command-buffer: command-buffer);
  }

  resource buffer {
    /// Sync host wait (L2); mode is map-mode-flags (READ / WRITE bits).
    map-async: func(mode: map-mode-flags, offset: u64, size: u64);
    get-mapped-range: func(offset: u64, size: u64) -> list<u8>;
    unmap: func();
  }

  resource shader-module {}
  resource bind-group-layout {}
  resource bind-group {}
  resource pipeline-layout {}
  resource compute-pipeline {}
  resource render-pipeline {}
  resource sampler {}
  resource texture {
    create-view: func() -> texture-view;
  }
  resource texture-view {}

  /// Android native-window surface (Host injects window handle; Guest does not create windows).
  resource surface {
    /// Picks preferred format from capabilities; returns format used.
    configure: func(
      device: borrow<device>,
      adapter: borrow<adapter>,
      width: u32,
      height: u32,
    ) -> texture-format;
    /// Encapsulates getCurrentTexture + createView; fails if acquire is not success.
    get-current-texture-view: func() -> texture-view;
    present: func();
    unconfigure: func();
  }

  resource command-encoder {
    begin-compute-pass: func() -> compute-pass-encoder;
    begin-render-pass-clear: func(
      view: borrow<texture-view>,
      r: f32,
      g: f32,
      b: f32,
      a: f32,
    ) -> render-pass-encoder;
    copy-buffer-to-buffer: func(
      source: borrow<buffer>,
      source-offset: u64,
      destination: borrow<buffer>,
      destination-offset: u64,
      size: u64,
    );
    finish: func() -> command-buffer;
  }

  resource compute-pass-encoder {
    set-pipeline: func(pipeline: borrow<compute-pipeline>);
    set-bind-group: func(index: u32, bind-group: borrow<bind-group>);
    dispatch-workgroups: func(x: u32, y: u32, z: u32);
    end: func();
  }

  resource render-pass-encoder {
    set-pipeline: func(pipeline: borrow<render-pipeline>);
    /// Bind a GPU buffer to a vertex slot (offset/size in bytes).
    set-vertex-buffer: func(
      slot: u32,
      buffer: borrow<buffer>,
      offset: u64,
      size: u64,
    );
    draw: func(vertex-count: u32);
    end: func();
  }

  resource command-buffer {}

  request-adapter: func() -> adapter;
  /// Android: native window from Util.windowFromSurface (u64 bit pattern).
  create-surface-from-native-window: func(window-handle: u64) -> surface;
}

world vector-add {
  import host;
  export run-vector-add: func(a: list<f32>, b: list<f32>) -> result<list<f32>, string>;
}

/// On-screen red triangle (Host injects Android native window).
/// Guest only holds `surface`; does not create windows / wasi-gfx canvas.
/// `run-triangle` = one-shot; `init-triangle` / `draw-frame` / `drop-triangle` = host-driven loop.
world triangle {
  import host;
  export run-triangle: func(
    window-handle: u64,
    width: u32,
    height: u32,
  ) -> result<_, string>;
  /// Configure surface + pipeline; leave surface configured for subsequent draw-frame.
  export init-triangle: func(
    window-handle: u64,
    width: u32,
    height: u32,
  ) -> result<_, string>;
  /// Acquire → clear pass → submit → present (no unconfigure).
  export draw-frame: func() -> result<_, string>;
  /// Unconfigure + release guest-held GPU resources from init-triangle.
  export drop-triangle: func() -> result<_, string>;
}
